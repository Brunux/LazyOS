/* rofi: the bar's dmenu and every menu that is still a script.
 *
 * The three jobs below moved to the framework (spec 012) and are listed here
 * only so the file is not mistaken for the launcher's theme:
 *   $mod+d / Search key   lazyos menu apps    applications (.desktop entries)
 *   $mod+Tab              lazyos menu window  window switcher
 *   $mod+Shift+d          lazyos menu run     commands from $PATH; Shift+Enter
 *                                             runs the choice in foot
 * What rofi still draws is `bar-pick` (rofi -dmenu) and the menus whose surface
 * has not been ported, so its theme is still the session's palette.
 *
 * Measured on this machine (headless swayfx, /proc PSS): rofi's dmenu 14.2-15.6 MB
 * while open, nothing resident afterwards. That replaced both tofi
 * (14.6 MB, applications only, its run mode only printed the selection) and fuzzel
 * (40.5 MB per bar popup), so the session went from two pickers to one.
 *
 * rofi 2.0 speaks Wayland natively: it is a layer-shell client (zwlr_layer_shell_v1)
 * and the window mode uses zwlr_foreign_toplevel_manager_v1, so neither Xwayland nor
 * an X11 build is involved. Debian's package is `rofi` (2.0.0), +6 packages / 1.75 MB
 * over the previous set.
 *
 * Syntax check: `rofi -show drun` in the session - a parse error is reported in a
 * dialog naming the file, line and column (`rofi -dump-config` does not report theme
 * parse errors, it only dumps the settings it managed to read).
 */

configuration {
    /* The three modes, in the order Ctrl+Tab would cycle them, plus the one
     * that is only reached by name: `ssh` lists ~/.ssh/config with rofi's own
     * parser (`rofi -show ssh`).  The calculator is not a mode: rofi calls a
     * script mode once at startup and again on selection, never while the query
     * changes, so ~/.config/bin/rofi-calc is a one-shot dmenu instead. */
    modes: [ drun, run, window ];
    modi: "drun,run,window,ssh";

    /* Both drun's Terminal=true entries (btop, htop, our own TUIs) and run mode's
     * Shift+Enter use this. foot is the session terminal. */
    terminal: "foot";

    /* Cleaner rows: "Foot" instead of "Foot (Terminal)". */
    drun-display-format: "{name}";
    window-format: "{t}";

    display-drun: "Launch";
    display-run: "Run";
    display-window: "Window";
    display-ssh: "SSH";

    /* Application icons, where the data has them: the launcher and the window
     * switcher.  rofi 2.0.0-0.2 decodes them with gdk-pixbuf (it links
     * libgdk-pixbuf-2.0-0 and carries no glycin); measured in the headless
     * session, drun costs 13 MB of PSS with ten rows of icons, and nothing stays
     * after the window closes.  The launcher is where an icon earns that; the
     * lists this port draws itself carry a font glyph instead (lib-rofi.sh),
     * which costs nothing, follows the palette and is already how the bar is
     * drawn - except the file browser, whose rows carry a real thumbnail
     * (rofi-files, 32 px, made by ~/.config/bin/lazyos-thumbnail), and rofi-keys,
     * which asks this theme for a picture by name on every row - the tool the
     * binding runs, the action it sends, or its section (-show-icons).
     *
     * bar-pick passes -no-show-icons, so the bar's popups keep the tighter
     * text-only layout.
     *
     * The theme is LazyOS, not Adwaita: Debian's Adwaita 51 ships only monochrome
     * *symbolic* icons and not one of the application names this session uses,
     * so the launcher showed a hole where an icon should be. The overlay ships
     * a solarized line icon per session entry (terminal, folder, gear, bell,
     * power...) in usr/share/icons/LazyOS, and its index.theme inherits Adwaita
     * and hicolor, so an application that brings its own icon (foot, btop,
     * htop) still gets it in colour.  scripts/make-icons.sh renders them, both
     * the launcher's names and the category names rofi-keys asks for. */
    show-icons: true;
    icon-theme: "LazyOS";

    /* fzf-style matching, as tofi and fuzzel did. */
    matching: "fuzzy";
    case-sensitive: false;
    sort: true;
    cycle: true;
    sidebar-mode: false;

    /* Keep the history (most used first) in ~/.cache/rofi3.druncache. */
    disable-history: false;

    /* Inhibit the compositor's shortcuts while a rofi window is open, through
     * zwp_keyboard_shortcuts_inhibit_v1.
     *
     * A layer-shell surface with exclusive keyboard interactivity does *not*
     * get this for free: sway evaluates its bindings before it forwards a key
     * to the focused surface (sway/input/keyboard.c, handle_key_event), and the
     * only thing that exempts a key from them is an active shortcuts inhibitor.
     * rofi asks for one only when this setting is on - `global-kb` defaults to
     * false (config/config.c) - so without it every binding of the session kept
     * working *behind* the open menu: Alt+1 switched to workspace 1 instead of
     * reaching -kb-custom-1, and Alt+q closed the window behind the list. That
     * is why the Alt+1 second actions (rofi-clip, rofi-emoji, rofi-places,
     * rofi-files) need this line, and why it is on for every menu and not per
     * script: the bar's popups have the same problem.
     *
     * The inhibition lasts exactly as long as the surface has focus, so it ends
     * with the window and cannot outlive it. */
    global-kb: true;

}

/* The look lives in its own file so the bar's dmenu and the launcher cannot drift
 * apart: both read this one theme. */
@theme "/home/brunux/.config/rofi/solarized.rasi"
