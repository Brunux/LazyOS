# Personal Sway overlay: keeps the system setup (/etc/sway/config) and adds the
# per-user bits. Ported from the maintainer's Nura session.
include /etc/sway/config

# Per-user drop-ins, read last so they win over the system configuration. The
# session writes here (rofi-layout keeps the keyboard layout it was given); an
# empty directory is fine, a glob that matches nothing is not an error.
include ~/.config/sway/config.d/*.conf

# Faster key repeat for every keyboard.
input type:keyboard {
    repeat_delay 300
    repeat_rate 33
}

# Use the Chromebook Search key by itself for the applications: it opens the
# same launcher as $mod+d ($launcher in /etc/sway/config, rofi -show drun, the
# .desktop entries including this port's own session actions). That is what the
# key did before the file search borrowed it, and it is the question the
# magnifier answers for most people.
#
# The Search key is a Super_L press, so this is bound on release and without
# repeat: the top row doubles as F1-F10 with Search held down (keyd, see
# etc/keyd/default.conf), and firing on press would open the launcher on the
# way to those.
bindsym --no-repeat --release Super_L exec $launcher

# Alt+Search is what the Search key used to be: rofi-files in its --search
# mode, one bounded fd run over $HOME listed by rofi, and Enter opens the
# choice with the program that fits it (text in bat, a picture in imv, a video
# in mpv, a PDF in papers), or browses the folder that was chosen. This is the
# one thing the launcher cannot do - there is no way to land on a file by
# typing its name from a list of .desktop entries.
#
# The chord has two paths because Search is a Super_L press and the order the
# keys are pressed in decides which one is taken:
#
#   * Alt first: keyd's [alt] layer maps Search to F20 (etc/keyd/default.conf),
#     and the F20 binding below opens the search on the press. Keyd consumes the
#     Search key, so the release bindings never see it and nothing opens twice.
#   * Search first, Alt still down when Search comes up: keyd forwarded
#     Super_L, and the release binding below matches the modifiers held at the
#     release. Released without Alt, it falls through to the launcher above.
bindsym --no-repeat F20 exec /home/brunux/.config/bin/rofi-files --search
bindsym --no-repeat --release Super_L+Mod1 exec /home/brunux/.config/bin/rofi-files --search

# Search+Shift is the same key held with Shift: the *terminal* file search
# (~/.config/bin/lazyos-find), fd streamed into fzf with a preview pane. The
# windowed manager (favnyr) moved to the Alt+Ctrl+Shift+F family in
# 24-keys.conf, where the Files key already lives, so this chord stays with the
# Search key: Search opens the launcher, Alt+Search the file list, Search+Shift
# the terminal filter - three lists, no window. The two do not compete: a
# release binding is matched against the modifiers held at the moment the key
# comes up, so Search released while Shift is still down lands here, and Search
# on its own falls through to the launcher above.
#
# It is bound on release for the same reason as the line above - the top row
# doubles as F1-F10 while Search is held (keyd), and it is `--no-repeat` because
# holding the key has nothing to repeat.
bindsym --no-repeat --release Super_L+Shift exec /home/brunux/.config/bin/lazyos-find
