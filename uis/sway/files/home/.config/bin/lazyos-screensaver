#!/bin/bash
# The LazyOS idle screen: a fullscreen terminal that loops the wordmark until a
# key is pressed or the pointer moves.
#
#   lazyos-screensaver          launch it (idempotent, and it returns at once;
#                               also the bar menu entry)
#   lazyos-screensaver --run    what runs *inside* the terminal (do not call)
#
# The idle screen is where the wordmark lives: the terminal draws the text art,
# and the mark itself (the launcher icon, the SVG) comes from
# scripts/make-brand.sh. The idea behind it is the lazy-tools family (lazygit,
# lazydocker and friends): the tool does the boring part, the thing you can press
# is on the screen, and the machine is allowed to look like it is having fun
# while it waits. Hence the wordmark and the arcade line underneath it:
# "press any key to play".
#
# The chain lives in etc/sway/config.d/23-lazyos-screensaver.conf: swayidle runs
# this at 150 s and ~/.config/bin/sway-lock at 300 s.  The launcher returns as
# soon as the window is started instead of waiting for it: swayidle runs the
# chain with `-w`, which blocks its whole event loop until each timed command
# exits (main.c, cmd_exec: waitpid), so a saver held in the foreground would
# keep the 300 s lock, the 360 s DPMS, the resume lines and before-sleep from
# ever running - the session would never lock while the wordmark was up.
#
# The animation is terminaltexteffects (`tte`), looping with --reuse-canvas so
# the wordmark never blinks between effects. Deboma loops ttfx at 120 fps; the
# frame rate is the whole cost here, so it is 30 (docs/optimization.md has the
# numbers: a full cycle of the seven effects is 70 s of wall time and 8.5 s of
# CPU, ~12 % of one core, where the same cycle at 120 fps takes 20 s and ~6.4 s
# of CPU, ~32 % of a core). tte's stdout *is* the animation: the first version
# of this script sent it to /dev/null while silencing the log, so the screen
# stayed black for the whole run ("the screensaver does not work, nothing
# moves").

set -u

APP_ID="org.lazyos.screensaver"
LOGO="${XDG_CONFIG_HOME:-$HOME/.config}/lazyos/screensaver.txt"
FOOT_INI="${XDG_CONFIG_HOME:-$HOME/.config}/foot/screensaver.ini"
# 30, because the frame rate is the whole cost of the loop: at 120 fps the same
# cycle is over in a third of the time, at three times the share of a core.
FPS=30
# The effects that end with the text sitting still (plus --reuse-canvas, which
# keeps the canvas between them). Anything heavier belongs in an animation, not
# in something that runs for the whole idle period on a battery.
EFFECTS="decrypt middleout print sweep wipe slide expand"

have_tte() {
	command -v tte >/dev/null 2>&1
}

center_logo() {
	# Print the art centred in the terminal, one line at a time: the captions
	# are narrower than the wordmark and must sit under it, not against the
	# left edge.
	#
	# The width is counted in *characters*, not bytes: the art is full-block and
	# box-drawing characters, three bytes each, so a byte count is almost three
	# times the column count and the logo ends up against the left edge instead
	# of the middle.  The regex strips UTF-8 continuation bytes, which is the one
	# way to do it identically in mawk (the image) and gawk (a build host); a
	# byte-range regex on lifted characters is a collation error, not a count.
	local rows cols
	read -r rows cols < <(stty size 2>/dev/null) || { rows=24; cols=80; }
	# A pty can report 0 0 before the compositor has given the window its size;
	# that is not a terminal to centre in.
	[ "${rows:-0}" -gt 0 ] 2>/dev/null || rows=24
	[ "${cols:-0}" -gt 0 ] 2>/dev/null || cols=80
	LC_ALL=C awk -v rows="${rows:-24}" -v cols="${cols:-80}" '
		function width(s,   t) {
			t = s
			gsub(/[\200-\277]/, "", t)
			return length(t)
		}
		{ lines[++n] = $0 }
		END {
			top = int((rows - n) / 2); if (top < 0) top = 0
			for (i = 0; i < top; i++) print ""
			for (i = 1; i <= n; i++) {
				pad = int((cols - width(lines[i])) / 2); if (pad < 0) pad = 0
				printf "%*s%s\n", pad, "", lines[i]
			}
		}' "$LOGO"
}

static_frame() {
	clear
	# No cursor, and the art in the brand's cyan (#2aa198): the z_ mark is
	# cyan everywhere it is drawn (brand/README.md).  "play" in the arcade line
	# is the cursor orange (#e8743b), as on the wallpaper and the web page.  The
	# colour goes in after centre_logo has padded the line, so the escapes are
	# never counted as columns; the art file itself stays plain text, because
	# tte reads it and would draw the escapes as characters.
	printf '\033[?25l\033[38;2;42;161;152m'
	center_logo | sed 's/ play «$/ \x1b[38;2;232;116;59mplay\x1b[38;2;42;161;152m «/'
}

run() {
	[ -t 0 ] || exit 1
	# Nothing is going to move for a while; let sway hide the pointer.  sway
	# keeps `hide_cursor` as a session-wide seat setting and has no IPC read for
	# it (get_seats reports only name, capabilities, focus and devices), so the
	# value in effect before this runs is recovered from the merged config and
	# put back on the way out.  Two things the first attempt got wrong: the
	# value was never restored, so the seat kept hiding the pointer after the
	# window closed; and `hide_cursor 1` is really 100 - sway clamps any timeout
	# under 100 and non-zero up to 100 ms, which is why "the desktop comes back
	# and the pointer disappears quickly".
	prev_hide_cursor=$(swaymsg -t get_config 2>/dev/null \
		| grep -oE 'hide_cursor[[:space:]]+[0-9]+' \
		| grep -oE '[0-9]+$' \
		| tail -n 1)
	prev_hide_cursor=${prev_hide_cursor:-0}
	swaymsg seat - hide_cursor 1 >/dev/null 2>&1 || true

	# Terminals allocate an 80x24 pty and only resize it once the compositor has
	# told the window how big it is; tte measures the terminal once, at startup,
	# so starting it earlier paints an 80x24 canvas into the corner
	# (omarchy-screensaver waits the same way).
	deadline=$((SECONDS + 2))
	while [ "$SECONDS" -lt "$deadline" ]; do
		size=$(stty size 2>/dev/null) || break
		case "$size" in
		"24 80"|"0 0"|"") sleep 0.02 ;;
		*) break ;;
		esac
	done

	# Any input ends it, one byte at a time: canonical mode would wait for Enter.
	stty -icanon -echo min 1 time 0 2>/dev/null || true
	# And the pointer reports too.  A terminal forwards the mouse only when the
	# program inside asks for it, so without these two escapes the loop below
	# only ever saw key bytes: motion and clicks were foot's own business (a
	# click started a selection), which is why the idle screen answered the
	# keyboard and nothing else.  1003 is all-motion tracking and 1006 the SGR
	# encoding it is read in; foot implements both (foot-ctlseqs(7)).
	printf '\033[?1003h\033[?1006h'
	# And no cursor: tte is told not to restore it, and nothing else draws.
	printf '\033[?25l'

	# Every way out gives the terminal back.  Left on, mouse reporting turns
	# the prompt of a `--run` in a real shell into a stream of escapes, and
	# leaves the cursor hidden after it.
	restore_terminal() {
		printf '\033[?1006l\033[?1003l\033[?25h'
		# Put the seat's hide_cursor timeout back to what it was before the
		# window hid it (0 unless a config set one).  Without this the seat
		# keeps hiding the pointer after foot closes, because the setting is
		# session-wide, not a property of the window.
		swaymsg seat - hide_cursor "$prev_hide_cursor" >/dev/null 2>&1 || true
	}
	trap restore_terminal EXIT
	trap 'exit 0' INT TERM HUP

	if ! have_tte || [ ! -r "$LOGO" ]; then
		# The animation is what is missing, not the screen: leave the art up.
		static_frame
		read -rsn1 || true
		exit 0
	fi

	failures=0
	while :; do
		# `--include-effects` takes the rest of the command line as its list
		# (argparse's nargs='+'), so it stays the last option here.
		#
		# stdin comes from /dev/null on purpose: tte reads the terminal for its
		# own controls and would swallow the key that is meant to dismiss this
		# (a key pressed during an effect reached tte, not the read below, and
		# the screen only ended when the next effect boundary came around).
		tte -i "$LOGO" --frame-rate "$FPS" \
			--reuse-canvas \
			--canvas-width 0 --canvas-height 0 \
			--anchor-canvas c --anchor-text c \
			--random-effect --no-eol --no-restore-cursor 2>/dev/null \
			--include-effects $EFFECTS </dev/null &
		pid=$!
		# Poll for input while the effect runs - a key or any mouse event, both
		# of which arrive as bytes on the pty: killing tte is what makes the
		# dismissal immediate instead of waiting for the effect to end.  A read
		# that times out (bash answers >128) means "nothing yet"; anything else
		# is a byte, eof or an error, i.e. the screen is wanted back or the
		# terminal is gone, and a loop that kept restarting tte against a closed
		# pty would spin.
		while kill -0 "$pid" 2>/dev/null; do
			read -rsn1 -t 1
			rc=$?
			if [ "$rc" -eq 0 ]; then
				kill "$pid" 2>/dev/null
				wait "$pid" 2>/dev/null
				exit 0
			fi
			if [ "$rc" -le 128 ]; then
				kill "$pid" 2>/dev/null
				wait "$pid" 2>/dev/null
				exit 0
			fi
		done
		wait "$pid" 2>/dev/null
		# A tte that cannot draw (a broken font, a missing shared library) would
		# otherwise restart forever; after three failures the static frame is
		# still a screensaver.
		if [ $? -ne 0 ]; then
			failures=$((failures + 1))
			if [ "$failures" -ge 3 ]; then
				static_frame
				read -rsn1 || true
				exit 0
			fi
		else
			failures=0
		fi
	done
}

case "${1:-}" in
--run)
	run
	;;
--*)
	printf 'lazyos-screensaver: unknown option %s\n' "$1" >&2
	exit 2
	;;
esac

# Never draw over a locked session: swayidle keeps running while swaylock holds
# the screen, so at 150 s the idle screen would start *underneath* the lock,
# burn CPU invisibly and leave a hidden window behind.
if pgrep -x swaylock >/dev/null 2>&1; then
	exit 0
fi

# One idle screen, no stacking.
if pgrep -f "$APP_ID" >/dev/null 2>&1; then
	exit 0
fi

if [ ! -r "$LOGO" ]; then
	printf 'lazyos-screensaver: %s is missing\n' "$LOGO" >&2
	exit 1
fi

# The window is started and left to itself, so this returns at once: swayidle
# runs the chain with `-w` and waits for each timed command to exit, so a
# foreground saver would hold the 300 s lock, the 360 s DPMS, the resume lines
# and before-sleep for as long as it animated.  `</dev/null` because the
# terminal inherited here is sway's and nothing below reads it; stderr stays, so
# a foot that cannot start still lands in the journal.
foot --app-id="$APP_ID" --config="$FOOT_INI" --title LazyOS \
	"$(readlink -f "$0")" --run </dev/null &
