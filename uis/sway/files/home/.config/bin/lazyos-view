#!/bin/sh
# lazyos-view FILE - open one file the way the Files menu (rofi-files) does.
#
# This is the handler the *desktop* needs, not the one the menu needs: there is
# no xdg-desktop-portal in this image, so an application that asks "open this
# for me" (favnyr's double click, "Open With" in any GIO program, `gio open`)
# resolves it through /etc/xdg/mimeapps.list, which points the types below at
# org.lazyos.view.desktop -> this script. rofi-files keeps its own copy of the
# same rules on purpose: it is the tested path and does not start a process to
# decide what to start, but the rules are identical, so a photo costs imv either
# way and never a browser.
#
#   text   -> bat, paged and solarized, in the floated `popup` foot window
#   image  -> imv, the GPU viewer (zoom, pan, rotate, slideshow); chafa's sixels
#             in that same foot window when imv cannot start
#   video  -> mpv, with mpv-mpris loaded so playerctl and the Media menu see it
#   doc    -> papers: PDF, DjVu, comics (CBZ/CBR/CB7/CBT), Illustrator
#   rest   -> firefox-esr: an HTML page, an EPUB, a .deb
#
# Every branch falls through to the browser when its program is missing, so a
# stripped image still opens the file instead of appearing to do nothing.

set -eu

usage() {
	printf 'usage: lazyos-view FILE\n' >&2
	exit 2
}

[ $# -ge 1 ] || usage
arg=$1
[ -n "$arg" ] || usage

# GIO passes a file:// URI (or a path, for a %f handler); both are accepted, and
# only the characters a local path can gain from that trip are decoded.
case $arg in
file://*)
	path=$(printf '%s' "$arg" | sed -e 's|^file://||' -e 's|%20| |g')
	;;
*) path=$arg ;;
esac

case $path in
/*) ;;
*) path=$PWD/$path ;;
esac

name=$(basename -- "$path")

if [ ! -e "$path" ]; then
	notify-send -a Files -i dialog-warning "$name" "Broken link, there is nothing there" 2>/dev/null || :
	exit 1
fi
if [ ! -r "$path" ]; then
	notify-send -a Files -i dialog-warning "$name" "Not readable by this user" 2>/dev/null || :
	exit 1
fi

browser() {
	if command -v firefox-esr >/dev/null 2>&1; then
		exec firefox-esr "file://$path"
	fi
	notify-send -a Files -i dialog-error "$name" "No program is installed to open this file" 2>/dev/null || :
	exit 1
}

# The document family first: papers is the reader (search, zoom, print,
# annotations), and a PDF's first page is often plain ASCII, which the NUL test
# below would open as garbage in bat. The extensions are papers' own MimeType
# list - and notably *not* EPUB, which papers 49 does not read.
case $(printf '%s' "$name" | tr 'A-Z' 'a-z') in
*.pdf | *.djvu | *.djv | *.cbz | *.cbr | *.cb7 | *.cbt | *.ai)
	if command -v papers >/dev/null 2>&1; then
		exec papers "$path"
	fi
	browser
	;;
esac

total=$(head -c 4096 -- "$path" 2>/dev/null | wc -c)
text=$(head -c 4096 -- "$path" 2>/dev/null | tr -d '\000' | wc -c)

kind=other
case $(printf '%s' "$name" | tr 'A-Z' 'a-z') in
*.jpg | *.jpeg | *.png | *.gif | *.webp | *.bmp | *.tif | *.tiff | *.avif | *.svg)
	kind=image
	;;
*.mp4 | *.mkv | *.webm | *.mov | *.avi | *.m4v | *.mpg | *.mpeg | *.ogv | *.wmv | *.flv | *.3gp)
	kind=video
	;;
esac

if [ "$kind" = image ] && command -v imv >/dev/null 2>&1; then
	# imv draws the picture on the GPU and gives zoom, pan, rotation and a
	# slideshow of the directory, which is what a viewer is for. The image
	# family is decided before the text test below on purpose: an SVG *is* a
	# text file, and with the old order it opened as source in bat and could
	# never be looked at. `--` keeps a name that begins with "-" from being read
	# as an option. The hint says the keys once per session, before the window
	# takes the screen; it never delays the picture and never fails the open.
	"$HOME/.config/bin/lazyos-image-hint" || :
	exec imv -- "$path"
elif [ "$kind" = image ] && command -v chafa >/dev/null 2>&1 &&
	command -v foot >/dev/null 2>&1; then
	# The fallback for a GPU where imv gets no EGL context: --hold keeps the
	# window up after chafa has drawn once and exited, and the inner sh waits
	# for foot to resize the pty (a terminal starts at 80x24 and only then
	# matches the window), so chafa measures the real size instead of painting
	# into a corner.
	exec foot --hold --app-id=popup --title="$name" \
		-e sh -c 'sleep 0.2; exec chafa -f sixels "$1"' chafa "$path"
elif [ "$text" -eq "$total" ]; then
	if command -v bat >/dev/null 2>&1 && command -v foot >/dev/null 2>&1; then
		# BAT_THEME=ansi is what the shell profile sets; foot runs the command
		# directly, so pass it here or bat paints in its own theme.
		exec foot --app-id=popup --title="$name" \
			env BAT_THEME=ansi bat --paging=always --style=numbers \
			--file-name="$name" -- "$path"
	fi
elif [ "$kind" = video ] && command -v mpv >/dev/null 2>&1; then
	# --no-config so nothing in ~/.config/mpv (a GUI driver, a shader, a profile
	# from another machine) can decide what this does: the session is
	# Wayland-native and mpv's default vo=gpu picks the Wayland context on its
	# own. --force-window shows the window before the first decoded frame,
	# --keep-open=no closes it at the end of the file. --no-config also empties
	# the script directories mpv-mpris is normally found in, so the plugin is
	# passed by path when it is installed - without it playerctl (and therefore
	# rofi-media and the bar) cannot see what is playing.
	set -- --no-config --no-resume-playback --force-window=yes --keep-open=no \
		--title="$name"
	if [ -r /etc/mpv/scripts/mpris.so ]; then
		set -- "$@" --script=/etc/mpv/scripts/mpris.so
	fi
	exec mpv "$@" -- "$path"
fi

browser
