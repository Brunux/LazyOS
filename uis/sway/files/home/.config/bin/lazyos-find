#!/bin/sh
# The terminal file search behind Search+Shift: every file under $HOME (or
# DIR) in one fzf, narrowed by typing, with a preview pane, and Enter hands the
# choice to lazyos-view - the same program a double click in favnyr uses.
#
#   lazyos-find            search $HOME
#   lazyos-find <dir>      search that directory instead
#
# The session has two answers to "where is that file", and they are different
# questions. The file list (Alt+Search) opens `rofi-files --search`, one bounded
# fd run listed as rofi rows with icons and thumbnails: it is the right tool for
# a file whose name you know, because the list is up in a menu and Enter opens
# it. This is the other one - fd streams the *whole* tree into fzf, so the
# prompt is up before the walk has finished, nothing is capped, and the preview
# pane answers "is this the one" without opening anything. Neither is resident:
# one fzf process while the window is open.
#
# Why fzf and not a separate picker: it is already in the image for the shell's
# Ctrl-R/Ctrl-T/Alt-C bindings (`packages/tools.list`), it filters as the
# producer streams instead of after it, and `--read0`/`--print0` means a name
# with a space, a tab or a newline is one row and one argument. Measured on the
# build host (19k files after the excludes below): first paint in 24 ms, a
# keystroke repaints in 5-35 ms, 35.6 MB of PSS while open. The numbers and the
# alternatives are in docs/optimization.md, "The terminal file search".
#
# The excludes are the same four `rofi-files --search` uses, and dotfiles are
# INCLUDED here (that search hides them): the whole tree is the pool, so a
# dotfile costs nothing in ranking, and ~/.config is a place people look for
# things. Queues and build trees are still out - .cache alone is 330k of the
# 350k files in this home, and .gitignore keeps vendor/build directories out of
# the list.
set -eu

prog=lazyos-find
bin=$HOME/.config/bin
self=$(command -v "$0" 2>/dev/null || printf '%s' "$0")
case $self in
	/*) ;;
	*) self=$PWD/$self ;;
esac

usage() {
	printf 'usage: %s [DIR]\n' "$prog" >&2
}

# A notification, because the key starts the window from the compositor: there
# is no terminal to print to, and a search that cannot run has to say why.
# `-a Files` groups it with the rest of the file feature and `-i system-search`
# is a name the LazyOS theme draws (so mako's icon-path resolves it).
fail() {
	printf '%s: %s%s\n' "$prog" "$1" "${2:+: $2}" >&2
	if [ $# -gt 1 ]; then
		notify-send -a Files -i system-search "$1" "$2" 2>/dev/null || :
	else
		notify-send -a Files -i system-search "$1" 2>/dev/null || :
	fi
	exit 1
}

mode=search
while [ $# -gt 0 ]; do
	case $1 in
		--preview) mode=preview; shift ;;
		--help|-h) usage; exit 0 ;;
		--) shift; break ;;
		-*) usage; exit 2 ;;
		*) break ;;
	esac
done

if [ "$mode" = preview ]; then
	[ $# -ge 1 ] || exit 2
	path=$1

	# The pane measures itself from the two variables fzf exports to a preview
	# command, because the terminal's own size is the whole window.
	cols=${FZF_PREVIEW_COLUMNS:-80}
	lines=${FZF_PREVIEW_LINES:-24}
	[ "$lines" -gt 3 ] || lines=3
	name=${path##*/}
	ext=""
	case $name in
		*.*) ext=$(printf '%s' "${name##*.}" | tr 'A-Z' 'a-z') ;;
	esac

	# A picture, a video frame or a PDF page: the same generator rofi-files
	# uses, into the same cache directory, and drawn with chafa's *symbols* -
	# sixels would paint over fzf's redraw, since the pane is part of the same
	# terminal rather than a window of its own. The decode is bounded: a
	# preview that waits is worse than a preview that says nothing.
	case $ext in
		jpg|jpeg|png|gif|webp|bmp|tif|tiff|avif|svg|mp4|mkv|webm|mov|avi|m4v|mpg|mpeg|ogv|wmv|flv|3gp|pdf)
			media=$(realpath -- "$path" 2>/dev/null || printf '%s' "$path")
			cache=$HOME/.cache/thumbnails/normal/$(printf '%s' "$media" | md5sum | cut -d' ' -f1).png
			mkdir -p -- "${cache%/*}" 2>/dev/null || :
			if [ ! -s "$cache" ]; then
				timeout 8 "$bin/lazyos-thumbnail" "$media" "$cache" 128 >/dev/null 2>&1 || :
			fi
			if [ -s "$cache" ] && command -v chafa >/dev/null 2>&1; then
				exec chafa -f symbols --size "${cols}x${lines}" -- "$cache" 2>/dev/null
			fi
			;;
	esac

	# Text is read where it is, the first 300 lines: a preview is not a reader.
	# The NUL test is the browser's: bat paints a binary as an empty page, and a
	# PDF or a video that got this far is binary by definition.
	total=$(head -c 4096 -- "$path" 2>/dev/null | wc -c)
	text=$(head -c 4096 -- "$path" 2>/dev/null | tr -d '\000' | wc -c)
	if [ "$total" -eq 0 ]; then
		printf 'empty file\n'
		exit 0
	fi
	if [ "$text" -eq "$total" ] && command -v bat >/dev/null 2>&1; then
		# BAT_THEME=ansi is the shell profile's setting; fzf runs this directly,
		# so it is passed here, and --terminal-width is what the pane is.
		BAT_THEME=ansi exec bat --paging=never --style=numbers --color=always \
			--line-range=:300 --terminal-width="$cols" --wrap=character \
			--file-name="$name" -- "$path"
	fi

	printf '%s\n' "$name"
	if command -v file >/dev/null 2>&1; then
		file --brief --mime-type -- "$path" 2>/dev/null || :
	fi
	du -h -- "$path" 2>/dev/null || :
	exit 0
fi

root=""
if [ $# -gt 0 ]; then root=$1; else root=$HOME; fi
if [ -z "$root" ] || [ ! -d "$root" ]; then
	fail "No such directory" "$root"
fi
root=$(cd -- "$root" && pwd)
# The prompt shows the path the way `rofi-files` names its rows.
case $root in
	"$HOME") shown="~" ;;
	"$HOME"/*) shown="~${root#"$HOME"}" ;;
	*) shown=$root ;;
esac

# Started from the compositor there is no terminal, so give it one: foot with
# this app-id is floated and centred by etc/sway/config.d/29-file-search.conf.
# Started from a shell it runs in that shell, which is what makes the key and
# the command the same program.
#
# The foot child is wrapped instead of exec'd: if the inner search cannot run
# (a missing fd/fzf/lazyos-view, a directory that disappeared), fail() prints
# the reason and exits non-zero, and the wrapper prints it in the window and
# waits for Enter.  Without that the window closes on the error and the only
# trace is a notification, which is exactly the "nothing happens" a key that
# cannot run must not look like.
if [ ! -t 0 ] || [ ! -t 1 ]; then
	command -v foot >/dev/null 2>&1 ||
		fail "No terminal to search in" "foot is missing, so the search has nowhere to draw"
	foot --app-id=lazyos-find --title="Find files" -e sh -c '
		"$1" "$2"
		rc=$?
		case $rc in
			0|130) exit 0 ;;
		esac
		printf "\nThe search stopped (exit %s). Press Enter to close.\n" "$rc"
		read -r _
	' sh "$self" "$root" ||
		fail "The search window could not open" "foot failed to start"
	exit 0
fi

# fd, fzf and the opener are the three ways this can come up empty, and each of
# them fails silently on its own (an empty list, a key that does nothing), so
# each one says which package is missing.
fd=$(command -v fd || command -v fdfind || :)
[ -n "$fd" ] || fail "Search is not available" "fd is missing (package fd-find)"
command -v fzf >/dev/null 2>&1 ||
	fail "Search is not available" "fzf is missing (package fzf)"
[ -x "$bin/lazyos-view" ] ||
	fail "Search cannot open files" "bin/lazyos-view is missing or not executable"

# fd prints NUL-separated paths relative to the root (the rows stay short and
# the scheme=path matcher works on them), so the search runs from the root and
# the opener receives a path it can resolve the same way.
cd -- "$root" || fail "Cannot enter $root" "$root"

# The header is constant, so `change` can put it back after the Ctrl+Y note; it
# carries no comma or parenthesis, which the bind syntax would read as its own.
hint='Enter opens - Ctrl+Y copies the path - Esc closes'

# --no-multi because the opener takes one file: a Tab that marked three rows
# would open the first and say nothing about the other two.
#
# --strip-cwd-prefix is not decoration: with --print0 fd prefixes every relative
# path with "./", so without the flag every row (and every path handed to the
# opener) carries two characters nobody types and every row is shifted right.
"$fd" --type f --hidden --strip-cwd-prefix \
	--exclude .cache --exclude .git --exclude node_modules \
	--exclude .local/share/containers \
	--print0 2>/dev/null |
	fzf --read0 --print0 --no-multi --no-mouse \
		--scheme=path --reverse --border=none --info=inline-right \
		--prompt="$shown > " --header="$hint" \
		--color=16,fg:13,hl:6,hl+:6,info:3,prompt:6,marker:6,spinner:6,header:3,fg+:7,bg+:0 \
		--preview="'$self' --preview {}" \
		--preview-window=right:55%:wrap:border-left \
		--bind="change:change-header($hint)" \
		--bind="ctrl-y:execute-silent(realpath -- {} | wl-copy)+change-header(copied the path)" |
	xargs -0 -r "$bin/lazyos-view"
