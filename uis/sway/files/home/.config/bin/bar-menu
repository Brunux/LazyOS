#!/bin/sh
# The bar's left-most button: applications, system settings and the session.
#
# Deboma's menu plugin lists the applications and the session actions in a
# Quickshell window.  This is the cheap equivalent: rofi over one table, one
# process per click.  `Terminal` is also on the right-click so the common case
# needs no menu at all (see waybar `custom/menu`).
#
# The list is grouped the way the rest of the session is: what opens something,
# the AI features (Agents and Dictation together, which is the brand's
# statement), the switches and panels, the tools that answer a question about
# the machine, and the session actions.  Every row carries a glyph (lib-rofi.sh),
# and the rows that open a picker are the same scripts the bar's indicators run,
# so there is one implementation per action.
#
# Every menu in this directory that answers a question about the machine has a
# row here - DNS, Packages, Colour, About, Reminders - because the root menu is
# where the manual points for them (02-rofi.md lists all five under "the rest of
# the menus live in the root menu"), and a row that goes missing is a documented
# keypress that answers nothing at all.
#
# Alt+Space (and the menu button) open this; Alt+Ctrl+O opens Settings, which is
# the switch panel without the session actions.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"


tmp=$(mktemp "${TMPDIR:-/tmp}/menu.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# The AI group opens with the action an agent exists for - a session - and the
# agent it starts is the one the Agents menu marks as the default, which is
# OpenCode until someone picks another (the image ships it: tools/opencode/).
# The name is read once, here, so the row says what it will start instead of
# making the person open the list to find out. rofi-agents --default applies the
# same rule and does the fallback itself; a send-off to an agent that is not
# installed is therefore a card, never a terminal that closes at once.
agent_default=$(head -n1 "${XDG_CONFIG_HOME:-$HOME/.config}/lazyos/agents/default" 2>/dev/null || :)
[ -n "$agent_default" ] || agent_default=opencode

while :; do
	{
		ui_row "$UI_I_TERM" 'Terminal' 'foot' terminal
		ui_row "$UI_I_FILES" 'Files' 'browse the filesystem' files
		ui_row "$UI_I_WINDOW" 'Files (window)' 'favnyr: folders, drag and drop, trash' files-window
		ui_row "$UI_I_SEARCH" 'Search inside files' 'the text in them, with ripgrep' grep
		ui_row "$UI_I_DISK" 'Places' 'home, disks, the configuration' places
		ui_row "$UI_I_CAMERA" 'Capture' 'screenshot, OCR, QR, recording' capture
		# The webcam, not the screen: guvcview's preview, its controls and its
		# photo/clip buttons. The glyph is the video camera, because Capture
		# already owns the still-camera one.
		ui_row "$UI_I_VIDEO" 'Camera' 'look through the webcam, take a photo' camera
		ui_row "$UI_I_DOWNLOAD" 'Download' 'a link, into ~/Downloads' download
		ui_row "$UI_I_COG" 'Settings' 'Wi-Fi, Bluetooth, night light, tablet mode, rotation' settings
		ui_row "$UI_I_BOOK" 'Learn' 'the manual, with search' learn
		ui_row "$UI_I_KEYBOARD" 'Keybindings' 'every binding, from the configuration' keys
		ui_row "$UI_I_CALC" 'Calculator' 'type it, Enter copies the result' calc
		ui_row "$UI_I_SMILE" 'Emoji' 'type a name, insert the glyph' emoji
		ui_row "$UI_I_CLIPBOARD" 'Clipboard' 'what was copied, back in one pick' clip
		ui_row "$UI_I_KEY" 'Password' '32 random characters, into the clipboard' password
		ui_row "$UI_I_TERM" 'SSH' 'hosts from ~/.ssh/config' ssh

		ui_heading 'ai'
		# Leftmost is the short route: a session with the default agent, in
		# ~/Work, one click. The list below it is where another agent is picked,
		# installed or given a second account.
		ui_row "$UI_I_CODE" 'Agent session' "$agent_default, in ~/Work" agent
		ui_row "$UI_I_USERS" 'Agents' 'Claude Code, Codex and the others' agents
		ui_row "$UI_I_MIC" 'Dictation' 'speak, and it is typed' dictate
		# The model that runs here: no network, no account, and the flags it was
		# measured into. Alt+Ctrl+M opens the same window (24-keys.conf).
		ui_row "$UI_I_CHIP" 'Local model' 'a 1.7B model, offline, on four cores' model

		ui_heading 'system'
		ui_row "$UI_I_WIFI" 'Wi-Fi' 'pick a network' wifi
		ui_row "$UI_I_QR" 'QR code' 'this network, or any text' qr
		ui_row "$UI_I_CLOUD" 'DNS' 'the resolver this connection uses' dns
		ui_row "$UI_I_BT" 'Bluetooth' 'pick a device' bt
		ui_row "$UI_I_VOLUME" 'Audio output' 'sinks and volume' audio
		ui_row "$UI_I_MUSIC" 'Media' 'play, pause, next' media
		ui_row "$UI_I_BELL" 'Notifications' 'history and do-not-disturb' notify
		# The screen on another machine: wayvnc on the loopback address, reached
		# through the ssh login the image already answers.  It is in this group
		# because it is a switch about the machine, not an application.
		ui_row "$UI_I_EYE" 'Share this screen' 'read-only, over ssh' vnc
		ui_row "$UI_I_CLOCK" 'Time zone' 'and network time' tz
		ui_row "$UI_I_TRASH" 'Free space' 'what is using it, and clean up' clean
		ui_row "$UI_I_CHIP" 'Auxiliary swap' 'a card as more memory, on every boot' swap
		# The one row here that rewrites a disk, and it is red like Power for
		# the same reason: it asks once more, in the menu it opens, and once
		# by typing the disk's name.  rofi-install is a front-end for
		# scripts/install-emmc.sh - the same copy with the same CONFIRM=yes.
		ui_row "$UI_I_SHIELD" 'Install LazyOS' 'copy this system to the internal disk' install "$UI_RED"
		ui_row "$UI_I_BUG" 'End a process' 'the heaviest twenty' kill
		ui_row "$UI_I_BOX" 'Packages' 'search, then install one' pkg
		# The account as a developer: the keys and the configuration in one
		# encrypted archive, the way back from it, and a report to attach to a
		# bug. Alt+Ctrl+D opens the same menu (24-keys.conf); this row is here
		# so it is also reachable by name and from the launcher.
		ui_row "$UI_I_CODE" 'Developer' 'profile export and restore, diagnostics' dev
		ui_row "$UI_I_BRUSH" 'Colour' 'the hex of a pixel, and the palette' colour
		ui_row "$UI_I_INFO" 'About' 'kernel, uptime, memory, battery' about

		ui_heading 'session'
		ui_row "$UI_I_CLOCK" 'Reminders' 'be told about it later' remind
		ui_row "$UI_I_LOCK" 'Lock' 'the session lock' lock
		ui_row "$UI_I_EYE" 'Screensaver' 'the idle screen, now' screensaver
		ui_row "$UI_I_PAUSE" 'Suspend' 'sleep until asked' suspend
		ui_row "$UI_I_MOON" 'Hibernate' 'needs a disk swap and resume=' hibernate
		# Log out, reboot and shut down live in rofi-power: they are the three
		# rows that cannot be undone, and that menu asks once more.  Keeping a
		# second, unconfirmed copy here is how a stray Enter reboots the machine.
		ui_row "$UI_I_POWER" 'Power' 'log out, reboot, shut down' power "$UI_RED"
	} >"$tmp"

	key=$(ui_pick 'Menu' 'Enter opens · Escape closes' <"$tmp") || exit 0

	case $key in
	terminal) exec foot ;;
	files) exec "$dir/rofi-files" ;;
	# The windowed file manager: the same directory, with a mouse. It is a
	# second row and not a replacement because the list is what the Search key
	# and Alt+Ctrl+F open, and it costs one process with no window.
	# Replaced pcmanfm with favnyr (Brunux/Favnyr-aarm64 v0.3.6).
	files-window) exec favnyr "$HOME" ;;
	# The text inside the files, as opposed to their names: rofi-files --search
	# is the other half of the same question.
	grep) exec "$dir/rofi-grep" ;;
	download) exec "$dir/rofi-download" ;;
	password)
		# hex, not base64: 32 characters with no shift key and no `+`, `/` or
		# `=` to be re-quoted when the password is pasted into a file or a URL,
		# and 16 bytes is still 128 bits. The value never reaches a notification:
		# mako keeps a history, and a password in it is a password on disk.
		if command -v openssl >/dev/null 2>&1; then
			ui_copy "$(openssl rand -hex 16)" \
				'A new password, 32 characters, is in the clipboard'
		else
			ui_say Password 'openssl is not installed (package openssl)' \
				critical "$UI_ICON_ERROR"
		fi
		exit 0
		;;
	places) exec "$dir/rofi-places" ;;
	capture) exec "$dir/rofi-capture" ;;
	camera) exec "$dir/lazyos-camera" ;;
	settings) exec "$dir/rofi-quick" ;;
	learn) exec "$dir/rofi-learn" ;;
	keys) exec "$dir/rofi-keys" ;;
	# The default agent, not the list: rofi-agents --default applies the same
	# rule the menu marks with ● and falls back to OpenCode.
	agent) exec "$dir/rofi-agents" --default ;;
	agents) exec "$dir/rofi-agents" ;;
	calc) exec "$dir/rofi-calc" ;;
	emoji) exec "$dir/rofi-emoji" ;;
	clip) exec "$dir/rofi-clip" ;;
	dns) exec "$dir/rofi-dns" ;;
	pkg) exec "$dir/rofi-pkg" ;;
	dev) exec "$dir/rofi-dev" ;;
	colour) exec "$dir/rofi-color" ;;
	about) exec "$dir/rofi-about" ;;
	remind) exec "$dir/rofi-remind" ;;
	ssh) exec rofi -show ssh ;;
	wifi) exec "$dir/bar-net" ;;
	qr) exec "$dir/rofi-qr" ;;
	bt) exec "$dir/bar-bt" ;;
	audio) exec "$dir/bar-audio" ;;
	media) exec "$dir/rofi-media" ;;
	notify) exec "$dir/rofi-notify" ;;
	vnc) exec "$dir/rofi-vnc" ;;
	tz) exec "$dir/rofi-tz" ;;
	clean) exec "$dir/rofi-clean" ;;
	swap) exec "$dir/rofi-swap" ;;
	install) exec "$dir/rofi-install" ;;
	kill) exec "$dir/rofi-kill" ;;
	dictate) exec "$dir/dictate" ;;
	model) exec "$dir/lazyos-model" ;;
	lock) exec "$dir/sway-lock" ;;
	screensaver) exec "$dir/lazyos-screensaver" ;;
	suspend) exec "$dir/sway-suspend" ;;
	hibernate) exec "$dir/sway-hibernate" ;;
	power) exec "$dir/rofi-power" ;;
	none) continue ;;
	*) exit 0 ;;
	esac
done
