// Solarized bar, ported from the maintainer's Deboma (Omarchy) session.
//
// Every pointer interaction that Deboma answers with a panel is answered here
// with a short-lived rofi popup from ~/.config/bin/bar-*, and nothing stays
// resident: the bar itself is the only process this file keeps alive.  Icons
// are written as \uXXXX so the codepoints are readable and survive any editor;
// they come from fonts-font-awesome-legacy (see uis/sway/README.md).
//
// Clicks:
//   busy        left: stop the task the spinner names   (see bar-busy)
//   menu        left: root menu   right: terminal
//   clock       left: switch format (time/seconds)   scroll: calendar months
//   updates     left: open the updater (only visible when something is pending)
//   tray        the StatusNotifier items of running applications
//   layout      left: next xkb layout (hidden with a single layout)
//   bluetooth   left: device list  right: bluetoothctl in a floating terminal
//   network     left: Wi-Fi list   right: nmtui in a floating terminal
//   volume      left: mute  right: output list  scroll: volume
//   brightness  scroll: backlight
//   battery     left: power panel  right: root menu
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "margin-top": 4,
    "margin-left": 6,
    "margin-right": 6,
    "modules-left": [
        "custom/menu",
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/busy",
        "custom/updates",
        "tray",
        "custom/keyboard-layout",
        "custom/bluetooth",
        "custom/vnc",
        "network",
        "pulseaudio",
        "backlight",
        "idle_inhibitor",
        "battery"
    ],
    "custom/menu": {
        "format": "<span font_desc='JetBrains Mono 13'>\uf17c</span>",
        "tooltip": false,
        "on-click": "~/.config/bin/bar-menu",
        "on-click-right": "foot"
    },
    // workspace icons: workstyle (tools/workstyle/) renames each workspace to
    // "3: <glyphs>", one per kind of window in it, and `{value}` is that whole
    // name - number included, so Alt+3 and the third pill still mean the same
    // thing, and a workspace with no window keeps its bare number. `{name}`
    // would drop the number (the module hands back only what is after the
    // colon) and `{icon}` would do the same.
    //
    // No persistent-workspaces on purpose: this module matches that list by
    // workspace *name*, and workstyle renames the workspaces, so every renamed
    // pill would come with a duplicate. (The "*": [1, 2, 3, 4, 5] shape this
    // file used to carry is the Hyprland module's format and drew nothing at
    // all here - a pill appears when its workspace exists.) `all-outputs`
    // stays for the day there is a second screen.
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{value}"
    },
    "sway/mode": {
        "format": "<span font_desc='JetBrains Mono 13'>\uf11c</span>  {}",
        "tooltip": false
    },
    "clock": {
        "format": "<span font_desc='JetBrains Mono 13'>\uf073</span>  {:%a %d %b  %H:%M}",
        "format-alt": "<span font_desc='JetBrains Mono 13'>\uf073</span>  {:%H:%M:%S}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1
        },
        "interval": 30
    },
    // What busy is doing, as a spinner: only there while an action runs
    // (nmcli scanning or joining, bluetoothctl scanning, du measuring), so the
    // bar is unchanged in the common case.  One shell per second is the price
    // of the frame; the module prints {"class":"empty"} when idle and
    // style.css collapses it.
    //
    // The card is also the stop button (`bar-busy stop`): clicking it runs the
    // command the running task registered in BUSY_STOP, and the toast the card
    // belongs to becomes "Stopped <label>" instead of a second notification.
    // The tasks that can be stopped that way are the Wi-Fi scan and join, the
    // Bluetooth scan, the du walk of Free space and a dictation recording; the
    // ones that cannot (an apt install, the DNS re-activation, a radio switch,
    // a Bluetooth connect) say so when the card is clicked, because they are
    // either already over or not safe to cut.  The tooltip carries "click to
    // stop" only when there is something to run.
    "custom/busy": {
        "exec": "~/.config/bin/bar-busy",
        "return-type": "json",
        "interval": 1,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/bin/bar-busy stop"
    },
    "custom/updates": {
        "exec": "~/.config/bin/bar-updates",
        "return-type": "json",
        "interval": 21600,
        "signal": 8,
        "tooltip": true,
        "on-click": "foot --app-id=popup bash -lc 'sudo apt update && sudo apt full-upgrade; echo; echo Press Enter to close; read -r _'"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10,
        "show-passive-items": true
    },
    // Screen sharing (Settings > Share this screen, and the root menu): an eye
    // while wayvnc serves this session read-only on the loopback address, and
    // nothing at all otherwise (style.css collapses .empty).  The module reads
    // the state file rofi-vnc keeps - one `sh` every ten seconds, no daemon -
    // and a start or a stop signals the bar (RTMIN+8), so the eye appears and
    // disappears at the moment it happens instead of on the next poll.  A right
    // click stops it: the one thing someone wants from an indicator that says
    // "you are being watched" is to be able to end it from the same place.
    "custom/vnc": {
        "exec": "~/.config/bin/rofi-vnc status --bar",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/bin/rofi-vnc",
        "on-click-right": "~/.config/bin/rofi-vnc stop"
    },
    "custom/keyboard-layout": {
        "exec": "~/.config/bin/bar-key",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/bin/bar-key next"
    },
    "custom/bluetooth": {
        "exec": "~/.config/bin/bar-bt status",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/bin/bar-bt",
        "on-click-right": "foot --app-id=popup bluetoothctl"
    },
    "network": {
        "interval": 10,
        "format-wifi": "<span font_desc='JetBrains Mono 13'>\uf1eb</span>",
        "format-ethernet": "<span font_desc='JetBrains Mono 13'>\uf233</span>  Ethernet",
        "format-linked": "<span font_desc='JetBrains Mono 13'>\uf1e6</span>  {ifname}",
        "format-disconnected": "<span font_desc='JetBrains Mono 13'>\uf05e</span>  Offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}\nGateway: {gwaddr}\nClick to pick a network",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}\nGateway: {gwaddr}",
        "on-click": "~/.config/bin/bar-net",
        "on-click-right": "foot --app-id=popup nmtui"
    },
    "pulseaudio": {
        "format": "<span font_desc='JetBrains Mono 13'>{icon}</span>",
        "format-muted": "<span font_desc='JetBrains Mono 13'>\uf026</span>  muted",
        "format-icons": {
            "default": [
                "\uf026",
                "\uf027",
                "\uf028"
            ]
        },
        "tooltip-format": "{desc} ({volume}%)",
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "~/.config/bin/bar-audio"
    },
    "backlight": {
        "device": "backlight-lcd0",
        "format": "<span font_desc='JetBrains Mono 13'>\uf185</span>",
        "tooltip-format": "Brightness {percent}%",
        "interval": 5,
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    // Keep the screen awake, on purpose, for the length of a film, a recipe or a
    // download watch.  This is waybar's own module: it holds a
    // zwp_idle_inhibitor_v1 on the bar's surface, so the session gains no helper
    // process and no script, and a click is the whole interface.  The coffee cup
    // is always visible (dim = the screen may sleep, yellow = it may not),
    // because the control has to be visible to be turned on; `start-activated`
    // stays false so a login never inherits it.
    //
    // Sway's own `inhibit_idle` is not what this uses: it has no `toggle` (only
    // focus|fullscreen|open|none|visible) and its user inhibitors belong to a
    // view, which would tie "keep awake" to a window.  The applications that
    // must not be interrupted are handled in config.d/32-idle-inhibit.conf, and
    // mpv asks for its own inhibitor.
    "idle_inhibitor": {
        "format": "<span font_desc='JetBrains Mono 13'>{icon}</span>",
        "format-icons": {
            "activated": "\uf0f4",
            "deactivated": "\uf0f4"
        },
        "tooltip-format-activated": "Keeping the screen awake\nClick to let it sleep",
        "tooltip-format-deactivated": "Click to keep the screen awake",
        "start-activated": false
    },
    "battery": {
        "bat": "sbs-8-000b",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span font_desc='JetBrains Mono 13'>{icon}</span>",
        "format-charging": "<span font_desc='JetBrains Mono 13'>\uf0e7</span>",
        "format-plugged": "<span font_desc='JetBrains Mono 13'>\uf1e6</span>",
        "format-full": "<span font_desc='JetBrains Mono 13'>\uf240</span>",
        "format-icons": [
            "\uf244",
            "\uf243",
            "\uf242",
            "\uf241",
            "\uf240"
        ],
        "tooltip-format": "Battery {capacity}%\nClick for draw, time left and memory",
        "interval": 30,
        "on-click": "~/.config/bin/bar-power",
        "on-click-right": "~/.config/bin/bar-menu"
    }
}
