#!/bin/sh
# xdg-open, the one operation this image needs from a desktop portal.
#
# This session ships no xdg-desktop-portal (it is a GTK/D-Bus daemon with
# nothing else here to talk to it), but "open this" is still asked for: foot
# ctrl+clicks a URL, `yt-dlp --print-trailer` prints one, a script opens a
# downloaded file. Without an xdg-open those all fail with "command not found".
#
# The browser is the answer to the URL half: a URL goes to it as it is. A path
# is "open this file", which is the question ~/.config/bin/lazyos-view already
# answers for a double click in favnyr - imv for a picture, papers for a
# document, mpv for a video, bat for text - so the shell and the desktop cannot
# disagree, and the browser stays the fallback (and the answer for a user with
# no session bin directory, e.g. root). A path handed to the browser becomes a
# file:// URL, absolute, so Firefox does not have to guess a working directory.
# The NUL-separated form (`xdg-open` with no arguments, reading paths from
# stdin) is deliberately not supported - nothing in this image uses it, and
# guessing would be worse than saying so.
#
# rofi-files does not call this: it has its own copy of the same rules, so the
# file browser works even if this script is removed.

set -eu

case ${1:-} in
'')
	printf 'usage: xdg-open URL|FILE\n' >&2
	exit 2
	;;
*://* | mailto:*)
	exec firefox-esr "$1"
	;;
*)
	case $1 in
	/*) path=$1 ;;
	*) path=$PWD/$1 ;;
	esac
	# The desktop's open-with rules, applied from a shell too. A user without
	# the session's bin directory (root, an ssh session) still gets the browser.
	if [ -n "${HOME:-}" ] && [ -x "$HOME/.config/bin/lazyos-view" ]; then
		exec "$HOME/.config/bin/lazyos-view" "$path"
	fi
	exec firefox-esr "file://$path"
	;;
esac
