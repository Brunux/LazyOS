" LazyOS theme: Matte Black (matte-black) - generated by `lazyos theme set`; do not edit.
" Change the theme (`lazyos theme set NAME`) or the template, then set it again.
" The session colourscheme: `:colorscheme lazyos`. Only the groups the editor
" shows while reading and writing are set - a full groups list is what a plugin
" like kanagawa is for, and this file is generated, so a hand edit is lost on
" the next theme switch.
set background=dark
highlight clear
if exists("syntax_on")
  syntax reset
endif
let g:colors_name = "lazyos"

hi Normal       guifg=#e4e4e7 guibg=#0e0e10 ctermfg=250 ctermbg=234
