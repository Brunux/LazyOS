# LazyOS theme: Matte Black (matte-black) - generated by `lazyos theme set`; do not edit.
# Change the theme (`lazyos theme set NAME`) or the template, then set it again.
# mako: the notification daemon, in the session theme's palette.
#
# Debian's package is "mako-notifier" (the binary is mako; the name "mako" is
# taken by a Python template library). sway starts it once per session from
# etc/sway/config.d/20-notifications.conf, and it owns
# org.freedesktop.Notifications on the session bus.
#
# Syntax check (parses the file, then fails on connecting if the config is
# valid and a notification daemon is already running):
#   mako -c <this file>
#   -> invalid options print "Failed to parse option '<key>'"; a good file
#      prints "Failed to acquire service name" instead.
#
# The palette comes from the active theme; the margins hang the card under the
# 30 px bar (outer-margin top = bar + the 4 px gap), so it never covers it.
#
# A card with no picture is what a name mako cannot resolve looks like - there is
# no log line and no error, only a notification that is text. So every
# notify-send in this session passes a name from the sets scripts/make-icons.sh
# renders, through lib-rofi.sh's ui_say or busy's own fourth argument.
font=JetBrains Mono 11
background-color=#0e0e10e0
text-color=#e4e4e7
border-color=#a1a1aa
border-size=2
border-radius=8
progress-color=over #a1a1aaff

# The notification's picture.  notify-send -i takes either a path or a *name*, and
# a name is resolved by mako searching icon-path for <size>/<category>/<name>.png.
# mako reads no icon-theme metadata at all (its man page says the search only
# approximates the XDG spec), so what goes here is the theme root: the LazyOS
# theme this session ships, whose index.theme inherits Adwaita and hicolor - and
# those two are searched anyway (with /usr/share/pixmaps), which is how an icon
# this image does not render (a browser, a package) still resolves.
icon-path=/usr/share/icons/LazyOS
# 48 is the size of the PNGs scripts/make-icons.sh renders, so the fixed-size copy
# is used as it is and nothing is scaled; the icon sits inside the card's 12 px
# padding, next to text at 11 px.
icons=1
max-icon-size=48
icon-border-radius=4

anchor=top-right
layer=overlay
outer-margin=40,10,10,10
margin=6
padding=12
width=380
height=140
max-visible=4
max-history=20
sort=-time
group-by=app-name
text-alignment=left

markup=1
format=<b>%s</b>\n%b
default-timeout=6000

# Low: the bar is not supposed to shout for a battery warning.
[urgency=low]
border-color=#8a8a8d
default-timeout=4000

# Critical: stays until it is dismissed, and reads as an alert.
[urgency=critical]
border-color=#ef4444
default-timeout=0
