/* LazyOS theme: Catppuccin Latte (catppuccin-latte) - generated by `lazyos theme set`; do not edit.
   Change the theme (`lazyos theme set NAME`) or the template, then set it again. */
/* The session palette for rofi, in the same roles it has everywhere else: the
 * theme's background, its surface as the selected card, its text, and its accent
 * for the prompt, the rim and the matched characters. Generated: `lazyos theme
 * set NAME` writes it, and an edit is reported instead of being lost.
 *
 * Loaded by ~/.config/rofi/config.rasi, so the launcher, the window switcher and
 * the bar's dmenu popups all look the same. The layout hides everything rofi
 * shows by default and does not need here: no mode switcher, no message bar, no
 * counter - one row of input and the list.
 *
 * One width for every window: 45% is the launcher's, sized for an application
 * name and nothing beside it. The menus built by lib-rofi.sh carry a name and a
 * detail, and a list whose rows do not fit asks for one of 62%, 76% or 88% for
 * that one run (-theme-str from ui_width, which measures the longest row), because
 * rofi cannot scroll a row sideways: a text wider than the box is cut by rofi
 * itself, and the end of a path is the part that identifies it.
 */

* {
    /* 0.82/0.88 rather than opaque: rofi is a layer-shell client and swayfx
     * draws the blur behind it (layer_effects "rofi" in
     * /etc/sway/config.d/26-swayfx.conf). The selected row stays darker and
     * more opaque than the list so the choice is unambiguous over any
     * wallpaper, and the accent rim is unchanged. */
    bg: rgba(239, 241, 245, 0.82);
    bg-alt: rgba(230, 233, 239, 0.88);
    fg: #4c4f69;
    fg-strong: #bcc0cc;
    accent: #1e66f5;
    dim: #9093a4;

    font: "JetBrains Mono 12";
    background-color: @bg;
    text-color: @fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 45%;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    padding: 12px;
    location: center;
    anchor: center;
}

/* One input row and the list; the mode switcher and the message bar are left out
 * of the layout entirely. */
mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 2px 4px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    text-color: @fg-strong;
}

listview {
    /* Up to ten rows, and the box shrinks to the number of entries it has: the
     * bar's three-item menus and the launcher's eight applications both get a box
     * that fits them, instead of ten rows with a gap under the list. */
    lines: 10;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
    padding: 0;
}

element {
    padding: 8px 10px;
    spacing: 10px;
    border-radius: 6px;
}

/* Used by the modes that show real images: drun and window (config.rasi), the
 * file browser (32 px, per menu) and rofi-keys, which asks the theme for a picture
 * by name on every row.  The lists built by lib-rofi.sh keep a font glyph in the
 * text instead and bar-pick passes -no-show-icons, so they never reserve this
 * column. */
element-icon {
    size: 26px;
    padding: 0 6px 0 0;
}

element-text {
    text-color: inherit;
}

element selected {
    background-color: @bg-alt;
    text-color: @fg-strong;
}
