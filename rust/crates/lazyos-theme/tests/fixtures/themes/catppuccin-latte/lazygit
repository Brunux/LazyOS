# LazyOS theme: Catppuccin Latte (catppuccin-latte) - generated by `lazyos theme set`; do not edit.
# Change the theme (`lazyos theme set NAME`) or the template, then set it again.
# lazygit's colours (lazygit >= 0.40 reads `gui.theme`, one key per element).
# The rest of lazygit's behaviour is left to its defaults on purpose: this file
# owns the palette and nothing else, so a theme switch cannot change a keybinding.
gui:
  theme:
    activeBorderColor:
      - "#1e66f5"
      - bold
    inactiveBorderColor:
      - "#6c6f85"
    searchingActiveBorderColor:
      - "#8839ef"
      - bold
    optionsTextColor:
      - "#8839ef"
    selectedLineBgColor:
      - "#ccd0da"
    cherryPickedCommitBgColor:
      - "#8839ef"
    cherryPickedCommitFgColor:
      - "#eff1f5"
    unstagedChangesColor:
      - "#d20f39"
    defaultFgColor:
      - "#4c4f69"
