/* LazyOS theme: Catppuccin Latte (catppuccin-latte) - generated by `lazyos theme set`; do not edit.
   Change the theme (`lazyos theme set NAME`) or the template, then set it again. */
/* The bar: restrained terminal aesthetic with consistent module spacing. The
   palette comes from the active theme (spec 004) - this file is generated. */
* {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    min-height: 0;
    border: none;
    border-radius: 0;
    transition: background-color 120ms ease, color 120ms ease;
}

/* The theme's colours, as roles */
/* The bar is a layer-shell surface with alpha < 1 so that swayfx can blur the
   wallpaper behind it (layer_effects "waybar" in
   /etc/sway/config.d/26-swayfx.conf). The cards below keep enough opacity for
   base1 text to stay readable over any wallpaper; the blur shows through the
   bar itself and between the cards. */
window#waybar {
    background: rgba(239, 241, 245, 0.71);
    color: #4c4f69;
    border-bottom: 1px solid #e6e9ef;
}

tooltip {
    background: #e6e9ef;
    color: #bcc0cc;
    border: 1px solid #9093a4;
    border-radius: 6px;
    padding: 5px 8px;
}

tooltip label {
    color: #bcc0cc;
}

/* Every indicator is the same card, whether it is a built-in module or one of
   the bar-* scripts: equal padding, height and background. */
#custom-menu,
#custom-busy,
#custom-updates,
#tray,
#custom-keyboard-layout,
#custom-bluetooth,
#custom-vnc,
#network,
#pulseaudio,
#backlight,
#idle_inhibitor,
#battery {
    margin: 4px 0;
    padding: 0 9px;
    background: rgba(230, 233, 239, 0.80);
    border: 1px solid rgba(233, 236, 241, 0.9);
    border-radius: 5px;
}

#custom-menu          { color: #1e66f5; } /* cyan */
#custom-busy          { color: #bc6b00; } /* yellow: something is happening */
#custom-updates       { color: #bc6b00; } /* yellow */
#custom-keyboard-layout { color: #aeb0bd; }
#custom-bluetooth     { color: #9093a4; }
#custom-bluetooth.on  { color: #8839ef; } /* blue */
#custom-vnc           { color: #bc6b00; } /* yellow: this session is being served */
#network              { color: #1e66f5; }
#network.disconnected {
    color: #d20f39;
    border-color: #d20f39;
}
#pulseaudio           { color: #8839ef; } /* violet */
#pulseaudio.muted     { color: #d20f39; }
#backlight            { color: #bc6b00; }
/* The coffee cup is a switch: dim is its off state, yellow is on. */
#idle_inhibitor       { color: #9093a4; }
#idle_inhibitor.activated { color: #bc6b00; } /* yellow: kept awake */
#battery              { color: #2d7a1e; }
#battery.warning      { color: #bc6b00; }
#battery.critical:not(.charging) {
    color: #d20f39;
    background: #eac8d3;
    border-color: #d20f39;
}
#battery.charging,
#battery.plugged { color: #1e66f5; }

#custom-menu:hover,
#custom-busy:hover,
#custom-updates:hover,
#custom-keyboard-layout:hover,
#custom-bluetooth:hover,
#custom-vnc:hover,
#network:hover,
#pulseaudio:hover,
#backlight:hover,
#idle_inhibitor:hover,
#battery:hover {
    background: rgba(233, 236, 241, 0.86);
}

/* The StatusNotifier icons keep their own colours; only the slot is themed. */
#tray {
    padding: 0 6px;
    color: #4c4f69;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    background: #eac8d3;
    border-color: #d20f39;
}

/* A module whose script reports nothing (no upgrades, a single keyboard
   layout) collapses to zero width instead of leaving an empty card on the
   bar.  The class comes from the JSON the script prints. */
#custom-updates.empty,
#custom-busy.empty,
#custom-keyboard-layout.empty,
#custom-vnc.empty {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

/* The centered clock is plain text, not a rounded module/card. */
#clock {
    color: #bcc0cc;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    margin: 0;
}

/* Workspace buttons look like compact terminal tabs. */
#workspaces {
    margin: 4px 2px 4px 0;
    padding: 0;
}

#workspaces button {
    min-width: 22px;
    padding: 0 7px;
    margin: 0 2px;
    background: rgba(230, 233, 239, 0.80);
    color: #4c4f69;
    border: 1px solid rgba(233, 236, 241, 0.9);
    border-radius: 5px;
    box-shadow: none;
}

#workspaces button:hover {
    background: #9093a4;
    color: #bcc0cc;
    border-color: #aeb0bd;
}

#workspaces button.focused,
#workspaces button.active {
    background: #1e66f5; /* cyan */
    color: #eff1f5;
    border-color: #1e66f5;
    box-shadow: none;
}

#workspaces button.urgent {
    background: #d20f39; /* red */
    color: #bcc0cc;
    border-color: #d20f39;
}

#workspaces button label {
    font-size: 12px;
    font-weight: 700;
}

#mode {
    margin: 4px 0;
    padding: 0 9px;
    color: #eff1f5;
    background: #bc6b00; /* yellow */
    border: 1px solid #bc6b00;
    border-radius: 5px;
}
