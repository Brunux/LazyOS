# LazyOS theme: Lumon (lumon) - generated by `lazyos theme set`; do not edit.
# Change the theme (`lazyos theme set NAME`) or the template, then set it again.
# fzf's colours, sourced by ~/.bashrc. fzf reads FZF_DEFAULT_OPTS from the
# environment; an exported `--color` block is the only way to keep it in one
# place, because fzf has no colour file.
export FZF_DEFAULT_OPTS="
  --color=fg:#d9eef7,bg:#16242d
  --color=hl:#8bc9eb,fg+:#ffffff,bg+:#28425d,hl+:#8bc9eb
  --color=info:#e5c07b,prompt:#8bc9eb,pointer:#4d9ed3
  --color=marker:#6fb8e3,spinner:#8bc9eb,header:#8799a2
  --color=border:#2c465e,label:#4d9ed3,query:#d9eef7
  --height=60% --layout=reverse --border=rounded --prompt='  '
"
