/* LazyOS theme: Lumon (lumon) - generated by `lazyos theme set`; do not edit.
   Change the theme (`lazyos theme set NAME`) or the template, then set it again. */
/* The bar: restrained terminal aesthetic with consistent module spacing. The
   palette comes from the active theme (spec 004) - this file is generated. */
* {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    min-height: 0;
    border: none;
    border-radius: 0;
    transition: background-color 120ms ease, color 120ms ease;
}

/* The theme's colours, as roles */
/* The bar is a layer-shell surface with alpha < 1 so that swayfx can blur the
   wallpaper behind it (layer_effects "waybar" in
   /etc/sway/config.d/26-swayfx.conf). The cards below keep enough opacity for
   base1 text to stay readable over any wallpaper; the blur shows through the
   bar itself and between the cards. */
window#waybar {
    background: rgba(22, 36, 45, 0.71);
    color: #d9eef7;
    border-bottom: 1px solid #1b2d40;
}

tooltip {
    background: #1b2d40;
    color: #ffffff;
    border: 1px solid #8799a2;
    border-radius: 6px;
    padding: 5px 8px;
}

tooltip label {
    color: #ffffff;
}

/* Every indicator is the same card, whether it is a built-in module or one of
   the bar-* scripts: equal padding, height and background. */
#custom-menu,
#custom-busy,
#custom-updates,
#tray,
#custom-keyboard-layout,
#custom-bluetooth,
#custom-vnc,
#network,
#pulseaudio,
#backlight,
#idle_inhibitor,
#battery {
    margin: 4px 0;
    padding: 0 9px;
    background: rgba(27, 45, 64, 0.80);
    border: 1px solid rgba(25, 42, 57, 0.9);
    border-radius: 5px;
}

#custom-menu          { color: #8bc9eb; } /* cyan */
#custom-busy          { color: #e5c07b; } /* yellow: something is happening */
#custom-updates       { color: #e5c07b; } /* yellow */
#custom-keyboard-layout { color: #64757e; }
#custom-bluetooth     { color: #8799a2; }
#custom-bluetooth.on  { color: #4d9ed3; } /* blue */
#custom-vnc           { color: #e5c07b; } /* yellow: this session is being served */
#network              { color: #8bc9eb; }
#network.disconnected {
    color: #e06c75;
    border-color: #e06c75;
}
#pulseaudio           { color: #4d9ed3; } /* violet */
#pulseaudio.muted     { color: #e06c75; }
#backlight            { color: #e5c07b; }
/* The coffee cup is a switch: dim is its off state, yellow is on. */
#idle_inhibitor       { color: #8799a2; }
#idle_inhibitor.activated { color: #e5c07b; } /* yellow: kept awake */
#battery              { color: #6fb8e3; }
#battery.warning      { color: #e5c07b; }
#battery.critical:not(.charging) {
    color: #e06c75;
    background: #3a313a;
    border-color: #e06c75;
}
#battery.charging,
#battery.plugged { color: #8bc9eb; }

#custom-menu:hover,
#custom-busy:hover,
#custom-updates:hover,
#custom-keyboard-layout:hover,
#custom-bluetooth:hover,
#custom-vnc:hover,
#network:hover,
#pulseaudio:hover,
#backlight:hover,
#idle_inhibitor:hover,
#battery:hover {
    background: rgba(25, 42, 57, 0.86);
}

/* The StatusNotifier icons keep their own colours; only the slot is themed. */
#tray {
    padding: 0 6px;
    color: #d9eef7;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    background: #3a313a;
    border-color: #e06c75;
}

/* A module whose script reports nothing (no upgrades, a single keyboard
   layout) collapses to zero width instead of leaving an empty card on the
   bar.  The class comes from the JSON the script prints. */
#custom-updates.empty,
#custom-busy.empty,
#custom-keyboard-layout.empty,
#custom-vnc.empty {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

/* The centered clock is plain text, not a rounded module/card. */
#clock {
    color: #ffffff;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    margin: 0;
}

/* Workspace buttons look like compact terminal tabs. */
#workspaces {
    margin: 4px 2px 4px 0;
    padding: 0;
}

#workspaces button {
    min-width: 22px;
    padding: 0 7px;
    margin: 0 2px;
    background: rgba(27, 45, 64, 0.80);
    color: #d9eef7;
    border: 1px solid rgba(25, 42, 57, 0.9);
    border-radius: 5px;
    box-shadow: none;
}

#workspaces button:hover {
    background: #8799a2;
    color: #ffffff;
    border-color: #64757e;
}

#workspaces button.focused,
#workspaces button.active {
    background: #8bc9eb; /* cyan */
    color: #16242d;
    border-color: #8bc9eb;
    box-shadow: none;
}

#workspaces button.urgent {
    background: #e06c75; /* red */
    color: #ffffff;
    border-color: #e06c75;
}

#workspaces button label {
    font-size: 12px;
    font-weight: 700;
}

#mode {
    margin: 4px 0;
    padding: 0 9px;
    color: #16242d;
    background: #e5c07b; /* yellow */
    border: 1px solid #e5c07b;
    border-radius: 5px;
}
