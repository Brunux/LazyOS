{{ header }}
# greetd flags for the active theme.
# This file is generated by `lazyos theme set` and sourced by the greetd service.
# Do not edit directly - change the theme instead.

# The wordmark for the greeter (the LazyOS mark)
wordmark = "{{ accent }}z_{{ warn }}_ {{ text }}lazyOS_"

# Colours for tuigreet 0.9.1 flags
# --background-color
bg = "{{ background:bare }}"
# --foreground-color
fg = "{{ foreground:bare }}"
# --accent-color
accent = "{{ accent:bare }}"
# --border-color
border = "{{ border:bare }}"
# --prompt-color
prompt = "{{ accent:bare }}"
# --input-color
input = "{{ foreground:bare }}"
# --error-color
error = "{{ danger:bare }}"
# --button-color
button = "{{ accent:bare }}"
# --button-hover-color
button_hover = "{{ hover:bare }}"
# --button-text-color
button_text = "{{ background:bare }}"